<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:RLIRL.App.Resources.Fonts"
             xmlns:viewmodels="clr-namespace:RLIRL.App.ViewModels"
             x:Class="RLIRL.App.Views.CameraViewerView"
             x:DataType="viewmodels:CameraViewerViewModel">

    <!-- Camera View Display -->
    <Border StrokeShape="RoundRectangle 8,8,8,8"
            Stroke="{StaticResource Gray300}"
            StrokeThickness="2"
            BackgroundColor="{StaticResource Black}"
            HeightRequest="300"
            Margin="0,10">
        <Grid>
            <!-- Video Stream (when available) -->
            <WebView IsVisible="{Binding VideoStreamSource, Converter={toolkit:IsNotNullConverter}}" 
                     BackgroundColor="Transparent"
                     Source="{Binding VideoStreamSource}"
                     x:Name="feedWebView" />

            <!-- Placeholder when no stream is selected or available -->
            <StackLayout IsVisible="{Binding VideoStreamSource, Converter={toolkit:IsNullConverter}}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Spacing="10">
                <Image MaximumWidthRequest="60">
                    <Image.Source>
                        <FontImageSource FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                         Glyph="{x:Static fonts:FluentUI.video_off_24_regular}"
                                         Size="60"
                                         Color="{StaticResource Gray500}" />
                    </Image.Source>
                </Image>
                <Label Text="{Binding SelectedCameraFeedId, StringFormat='Camera Feed {0}', TargetNullValue='No Camera Selected'}"
                       TextColor="{StaticResource Gray500}"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="Select a camera source to view feed"
                       TextColor="{StaticResource Gray400}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding SelectedCameraFeedId, Converter={toolkit:IsNullConverter}}" />
            </StackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsVisible="{Binding IsLoading}"
                              IsRunning="{Binding IsLoading}"
                              Color="{StaticResource DodgerBlue}"
                              VerticalOptions="Center"
                              HorizontalOptions="Center" />
        </Grid>
    </Border>
</ContentView>