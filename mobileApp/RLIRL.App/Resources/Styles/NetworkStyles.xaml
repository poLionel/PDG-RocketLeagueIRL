<?xml version="1.0" encoding="utf-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Network Grid Styles -->
    <Style x:Key="NetworkItemGrid" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource SmallPadding}" />
        <Setter Property="ColumnSpacing" Value="{StaticResource SmallSpacing}" />
    </Style>

    <Style x:Key="ConnectedNetworkGrid" TargetType="Grid" BasedOn="{StaticResource NetworkItemGrid}">
        <Setter Property="BackgroundColor" Value="#40ADD8E6" />
    </Style>

    <!-- Network Label Styles -->
    <Style x:Key="NetworkNameLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ConnectedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource DodgerBlue}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>