<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RLIRL.App.Views.MenuPage">
    <ScrollView Style="{StaticResource AdminMainScrollView}">
        <Border Style="{StaticResource AppSectionContainer}">
            <StackLayout Spacing="{StaticResource ItemSpacing}">
                <Label Text="Rocket League IRL" Style="{StaticResource AppPageTitle}" HorizontalTextAlignment="Center" />
                <Label Text="Choose your game mode" Style="{StaticResource AppSubtitle}" HorizontalTextAlignment="Center" />
                
                <StackLayout Spacing="{StaticResource SmallSpacing}" Margin="0,20,0,0">
                    <Button Text="Play" Clicked="OnPlay" Style="{StaticResource AdminPrimaryButton}" />
                    <Button Text="Connect your car" Clicked="OnConnect" Style="{StaticResource AdminPrimaryButton}" />
                    <Button Text="Spectate a game" Clicked="OnSpectate" Style="{StaticResource AdminPrimaryButton}" />
                    <Button Text="Manage a game" Clicked="OnAdmin" Style="{StaticResource AdminPrimaryButton}" />
                </StackLayout>
            </StackLayout>
        </Border>
    </ScrollView>
</ContentPage>